# Settings app is a system_app, allow calls to iris hwservice
hal_client_domain(system_app, hal_display_iris)

allow system_app vendor_audio_device:dir search;
allow system_app vendor_audio_device:file rw_file_perms;
allow system_app vendor_audio_device:chr_file rw_file_perms;

allow system_app fpsensor_data_file:sock_file { write };
allow system_app fpsensor_data_file:dir { search };
allow system_app hal_fingerprint_default:fd {use};

allow system_app fp_hardware_version:file r_file_perms;
